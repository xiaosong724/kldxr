<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网权限：游戏要和电脑上的服务器通信 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 保持屏幕常亮（玩的时候不锁屏） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- ★ 2026-10-23：APK 自更新要装新包 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== 关于 APK 自更新 =====
     ★ 不需要 FileProvider ✓ 直接用 DownloadManager 给的 content:// URI
       （系统自带读取授权 ✓）→ 项目保持【零第三方依赖】✓
     ★ 需要的权限：REQUEST_INSTALL_PACKAGES（上面已声明 ✓）
================================ -->
    </application>
</manifest>
